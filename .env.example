# ============================================
# EZ ADS — Environment variables (SERVER)
# Copy this file to server/.env and fill values.
# NEVER commit real secrets.
# ============================================

# --- Core ---
NODE_ENV=development
PORT=5000

# --- MongoDB (Atlas free tier or local) ---
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ezads?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ezads

# --- Auth / sessions ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
OAUTH_STATE_SECRET=change_me_too_another_long_random_string
# AES key material used to encrypt OAuth access tokens at rest (32+ random chars)
TOKEN_ENC_KEY=change_me_as_well_another_long_random_string

# --- CORS ---
CLIENT_ORIGIN=http://localhost:5173

# --- Meta / Instagram OAuth (Phase 3) ---
# From developers.facebook.com -> your app -> Instagram -> Business Login for Instagram
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/auth/instagram/callback
# Scopes requested at login (comma separated)
META_SCOPES=instagram_business_basic

# Development-only mock Instagram OAuth when META_APP_ID is empty.
# Mock accounts are clearly labeled as mock in the UI and DB. Never enable in production.
OAUTH_MOCK_MODE=true

# --- Email (Phase 3: brand verification + password reset) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="EZ Ads <no-reply@ezads.example>"

# --- Cloudinary (Phase 4: image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin provisioning (scripts/seedAdmin.js) ---
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
